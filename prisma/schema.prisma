// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id            String               @id @default(uuid())
  name          String
  email         String               @unique
  passwordHash  String               @map("password_hash")
  createdAt     DateTime             @default(now()) @map("created_at")
  subjects      Subject[]
  sessions      AttendanceSession[]

  @@map("teachers")
}

model Subject {
  id        String       @id @default(uuid())
  code      String       // e.g. "DW", "CN", "DBMS"
  name      String       // e.g. "Data Warehousing"
  teacherId String       @map("teacher_id")
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes   ClassGroup[]

  @@map("subjects")
}

model ClassGroup {
  id               String           @id @default(uuid())
  subjectId        String           @map("subject_id")
  name             String           // e.g. "CSE-A", "IT-B"
  plannedLectures  Int              @default(30) @map("planned_lectures")
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roster           StudentRoster[]
  sessions         AttendanceSession[]

  @@map("class_groups")
}

model StudentRoster {
  id       String     @id @default(uuid())
  classId  String     @map("class_id")
  rollNo   String     @map("roll_no")
  name     String
  class    ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, rollNo])
  @@map("student_roster")
}

model AttendanceSession {
  id         String             @id @default(uuid())
  classId    String             @map("class_id")
  teacherId  String             @map("teacher_id")
  status     SessionStatus      @default(ACTIVE)
  startedAt  DateTime           @default(now()) @map("started_at")
  endedAt    DateTime?          @map("ended_at")
  expiresAt  DateTime           @map("expires_at")
  class      ClassGroup         @relation(fields: [classId], references: [id])
  teacher    Teacher            @relation(fields: [teacherId], references: [id])
  tokens     AttendanceToken[]
  records    AttendanceRecord[]

  @@map("attendance_sessions")
}

enum SessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

model AttendanceToken {
  id                String            @id @default(uuid())
  sessionId         String            @map("session_id")
  token             String            @unique
  deviceFingerprint String?           @map("device_fingerprint")
  cookieId          String            @map("cookie_id")
  issuedAt          DateTime          @default(now()) @map("issued_at")
  expiresAt         DateTime          @map("expires_at")
  usedAt            DateTime?         @map("used_at")
  session           AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("attendance_tokens")
}

model AttendanceRecord {
  id                String            @id @default(uuid())
  sessionId         String            @map("session_id")
  rollNo            String            @map("roll_no")
  name              String
  deviceFingerprint String            @map("device_fingerprint")
  ip                String
  userAgent         String            @map("user_agent")
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  session           AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // One device per session — the core anti-fraud constraint
  @@unique([sessionId, deviceFingerprint])
  // One roll number per session
  @@unique([sessionId, rollNo])
  @@map("attendance_records")
}
